<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天记录管理页：时间筛选 → 多选 → 删除 / 导出。
     这台机器 Toast 合成后看不见，所以所有反馈都写到 tv_path 这行文字上。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:paddingBottom="56dp">

    <!-- ================= 顶栏 ================= -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/bg_topbar"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_off"
            android:text="@string/back"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/records_title"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/clear_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_off"
            android:text="@string/records_clear_all"
            android:textSize="16sp"
            android:textColor="@color/danger"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- ================= 时间段筛选 ================= -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_topbar"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/r_range0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_off"
            android:text="@string/records_today"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/r_range1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_pill_off"
            android:text="@string/records_7d"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/r_range2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_pill_off"
            android:text="@string/records_30d"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/r_range3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_pill_on"
            android:text="@string/records_all"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_stat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:gravity="end"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:text="" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- ================= 记录列表 ================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="true">

            <LinearLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="@color/text_hint"
            android:text="@string/records_empty"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 状态行：导出路径 / 操作结果都写在这 -->
    <TextView
        android:id="@+id/tv_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_topbar"
        android:paddingStart="18dp"
        android:paddingTop="6dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:text="" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- ================= 批量操作 ================= -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@color/bg_topbar"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/tv_sel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/brand"
            android:text="已选 0 条" />

        <TextView
            android:id="@+id/b_sel_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_off"
            android:text="@string/sel_all"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/b_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_off"
            android:text="@string/sel_copy"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/b_export"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_off"
            android:text="@string/sel_export"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/b_del"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_off"
            android:text="@string/sel_del"
            android:textSize="15sp"
            android:textColor="@color/danger"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
