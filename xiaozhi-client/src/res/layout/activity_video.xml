<?xml version="1.0" encoding="utf-8"?>
<!--
  视频播放页（U1 伪全屏）。

  布局要点：画面铺满整屏，底部留一条 84dp 的常驻控制栏 —— 不自动隐藏。
  为什么不全屏隐藏控制栏：这台音箱没有遥控器，唯一的手是「触摸屏 + 语音」；
  控制栏一旦隐藏，用户就找不到麦克风按钮，等于把语音交互锁死了。
  84dp 在 1280×800 上只占底部约 8%，不影响看片。

  dock 已改成自动隐藏（缩成左下角 29px 宽的箭头手柄），底部 75px 是空的，
  所以画面不再为 dock 让位；paddingStart 34dp 是为了不被那个箭头压住「退出」。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/video_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/video_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:textSize="18sp"
        android:textColor="@color/video_text"
        android:visibility="gone" />

    <!--
      字幕层（T4）：浮在画面底部、控制栏上方，宽度吃满屏。

      以前字幕挤在 84dp 控制栏右边、只给 2 行 —— 云端念一段清单（一百多字）
      会被截成一行「…」，等于把要看的字吃掉一半。现在独立成层：
      宽了（整屏 - 两侧 28dp）、行数到 3 行、字号 20sp，
      仍然超长就按标点切段轮播（VideoActivity.setCaption），绝不丢内容。
    -->
    <TextView
        android:id="@+id/video_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="92dp"
        android:background="@drawable/bg_video_caption"
        android:gravity="center"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:textSize="20sp"
        android:textColor="@color/video_text"
        android:visibility="gone" />

    <!-- 底部常驻栏：退出 / 麦克风 / 进度 / 字幕 -->
    <LinearLayout
        android:id="@+id/video_bar"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_video_bar"
        android:gravity="center_vertical"
        android:paddingStart="34dp"
        android:paddingEnd="18dp"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/video_exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_video_pill"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="退出"
            android:textColor="@color/video_text"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/video_mic"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/circle_button"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic"
            android:contentDescription="说话"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:layout_marginStart="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/video_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/video_text_dim"
                android:text="00:00 / 00:00" />

            <SeekBar
                android:id="@+id/video_seek"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginTop="2dp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/seekbar_track"
                android:thumb="@drawable/seekbar_thumb"
                android:splitTrack="false"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:contentDescription="播放进度，可拖动" />
        </LinearLayout>

        <!--
          控制栏右侧只放**短状态**（已暂停 / ♪ 歌名 / 跳到 03:00 …）。
          长句、台词、清单一律走上面的 video_caption 字幕层 —— 塞这里必然被截断。
        -->
        <TextView
            android:id="@+id/video_sub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textColor="@color/video_text"
            android:text="点麦克风说话：暂停 / 继续 / 下一首 / 换片" />
    </LinearLayout>
</FrameLayout>
