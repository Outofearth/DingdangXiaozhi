<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:paddingBottom="56dp">

    <!-- ================= 顶栏 ================= -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/bg_topbar"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:text="@string/status_ready" />

        <!-- 连续对话开关 -->
        <TextView
            android:id="@+id/btn_continuous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_off"
            android:text="@string/continuous"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:clickable="true"
            android:focusable="true" />

        <!-- 摄像头开关（大号圆形按钮，开着是实心绿 + 白色相机） -->
        <ImageView
            android:id="@+id/btn_camera"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_cam_off"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_camera"
            android:contentDescription="@string/camera"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_records"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pill_off"
            android:text="@string/records"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pill_off"
            android:text="@string/settings"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- ================= 聊天区（微信风气泡，可上下滚动看历史） ================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/chat_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="true">

            <LinearLayout
                android:id="@+id/chat_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/chat_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="16sp"
            android:textColor="@color/text_hint"
            android:text="对话会显示在这里\n按住「按住说话」按钮开始，或打开「连续对话」" />

        <!-- 多选操作条（长按消息 → 多选 后出现，盖在聊天区底部） -->
        <LinearLayout
            android:id="@+id/chat_sel_bar"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_sel_bar"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/sel_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/brand"
                android:text="已选 0 条" />

            <TextView
                android:id="@+id/sel_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_off"
                android:text="@string/sel_all"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/sel_copy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_off"
                android:text="@string/sel_copy"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/sel_export"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_off"
                android:text="@string/sel_export"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/sel_del"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_off"
                android:text="@string/sel_del"
                android:textSize="14sp"
                android:textColor="@color/danger"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/sel_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_on"
                android:text="@string/sel_cancel"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </FrameLayout>

    <!-- ================= 底部操作栏 ================= -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="152dp"
        android:background="@color/bg_topbar"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:baselineAligned="false">

        <!-- 麦克风状态（点击切换软件层开关） -->
        <LinearLayout
            android:id="@+id/mic_chip"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/mic_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_mic"
                android:contentDescription="@string/mic_on" />

            <TextView
                android:id="@+id/mic_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:text="@string/mic_on" />
        </LinearLayout>

        <TextView
            android:id="@+id/hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:text="按住按钮说话；点麦克风图标可关闭软件收音" />

        <Button
            android:id="@+id/talk"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/circle_button"
            android:text="@string/talk_hint"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#ffffff" />
    </LinearLayout>
</LinearLayout>
