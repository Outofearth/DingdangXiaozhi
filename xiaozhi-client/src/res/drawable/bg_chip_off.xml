<?xml version="1.0" encoding="utf-8"?>
<!--
  麦克风状态胶囊 —— **关闭**态：浅灰底 + 灰边，配合灰色图标/文字。
  开启态见 bg_chip.xml。这个底色变化是"远端可读"的关键：
  原来关掉时只是图标由绿变灰、文字变灰，在白面板上几乎看不出来。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E6E6E6" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#D2D2D2" />
            <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F4F4F4" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#E0E0E0" />
            <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
        </shape>
    </item>
</selector>
