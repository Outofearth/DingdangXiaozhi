<?xml version="1.0" encoding="utf-8"?>
<!--
  麦克风状态胶囊 —— **开启**态：白底 + 淡边，绿色麦克风图标。
  关闭态的对应文件是 bg_chip_off.xml（灰底），由 MainActivity.updateToggleUi 切换。
  两态底色不同，是为了在远处也能看出"收音开着还是关着"，
  不能只靠图标那一小点颜色和 15sp 文字。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_soft" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#A9DFC1" />
            <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#DCDCDC" />
            <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
        </shape>
    </item>
</selector>
